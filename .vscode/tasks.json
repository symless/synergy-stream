{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "dependsOn": ["build-cmake"],
      "windows": {
        "command": "robocopy ${workspaceFolder}/build/bin ${workspaceFolder}/build/bin-copy /R:0 /E /S /NJS /NJH /NFL /NDL; exit 0"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build-cmake",
      "type": "cmake",
      "command": "build",
      "targets": ["all"],
      "preset": "${command:cmake.activeBuildPresetName}",
      "group": "build",
      "problemMatcher": {
        "base": "$gcc",
        "fileLocation": ["absolute"]
      }
    },
    {
      "label": "build-kill-core",
      "dependsOn": ["kill-daemon", "kill-core", "build"],
      "dependsOrder": "sequence"
    },
    {
      "label": "build-kill-gui",
      "dependsOn": ["kill-gui", "kill-core", "build"],
      "dependsOrder": "sequence"
    },
    {
      "label": "build-silent",
      "type": "shell",
      "dependsOn": ["build"],
      "group": "build",
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "label": "clean",
      "type": "cmake",
      "command": "build",
      "targets": ["clean"],
      "preset": "${command:cmake.activeBuildPresetName}",
      "group": "build"
    },
    {
      "label": "clean-gcda",
      "type": "shell",
      "command": "find . -name '*.gcda' -delete",
      "windows": {
        "command": "$null"
      },
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "label": "clean-qt",
      "type": "shell",
      "command": "rm -r build/src/apps/deskflow-gui build/src/lib/gui",
      "windows": {
        "command": "remove-item -recurse build/src/apps/deskflow-gui,build/src/lib/gui"
      }
    },
    {
      "label": "clean-config",
      "type": "shell",
      "linux": {
        "command": "rm -f ~/.config/synergy-stream/synergy-stream.conf"
      },
      "windows": {
        "command": "remove-item $env:APPDATA\\synergy-stream\\synergy-stream.conf"
      },
      "osx": {
        "command": "rm -f ~/Library/synergy-stream/synergy-stream.conf"
      }
    },
    {
      "label": "kill-all",
      "type": "shell",
      "dependsOn": ["kill-gui", "kill-daemon", "kill-core"]
    },
    {
      "label": "kill-gui",
      "type": "shell",
      "command": "killall -v -9 synergy-stream || true",
      "osx": {
        "command": "killall -v -9 SynergyStream || true"
      },
      "windows": {
        "command": "taskkill /F /IM synergy-stream.exe; $true"
      }
    },
    {
      "label": "kill-daemon",
      "type": "shell",
      "command": "echo noop > /dev/null",
      "windows": {
        "command": "taskkill /F /IM synergy-stream-daemon.exe; $true"
      },
      "dependsOn": ["daemon-stop"]
    },
    {
      "label": "kill-core",
      "type": "shell",
      "command": "killall -v -9 synergy-stream-core || true",
      "windows": {
        "command": "taskkill /F /IM synergy-stream-core.exe; $true"
      }
    },
    {
      "label": "gui",
      "type": "process",
      "command": "${workspaceFolder}/build/bin/synergy-stream",
      "problemMatcher": [],
      "dependsOn": ["build"],
      "windows": {
        "dependsOn": ["build-kill-gui"],
        "command": "${workspaceFolder}/build/bin-copy/synergy-stream.exe"
      },
      "osx": {
        "command": "${workspaceFolder}/build/bin/SynergyStream.app/Contents/MacOS/SynergyStream"
      }
    },
    {
      "label": "daemon",
      "type": "process",
      "command": "echo noop > /dev/null",
      "problemMatcher": [],
      "dependsOn": ["daemon-stop", "build"],
      "windows": {
        "command": "${workspaceFolder}/build/bin-copy/synergy-stream-daemon.exe",
        "args": ["-f"]
      }
    },
    {
      "label": "daemon-stop",
      "type": "shell",
      "command": "echo noop > /dev/null",
      "windows": {
        "command": "foreach ($n in 'Synergy Stream Daemon (development)','SynergyStream') { if (Get-Service -Name $n -ErrorAction SilentlyContinue) { Stop-Service -Name $n -Force; while ((Get-Service -Name $n).Status -ne 'Stopped') { Start-Sleep -Seconds 1 } } }"
      }
    },
    {
      "label": "daemon-start",
      "type": "shell",
      "command": "echo noop > /dev/null",
      "windows": {
        "command": "Start-Service -Name 'Synergy Stream Daemon (development)'; while ((Get-Service -Name 'Synergy Stream Daemon (development)').Status -ne 'Running') { Start-Sleep -Seconds 1 }"
      }
    },
    {
      "label": "daemon-restart",
      "type": "shell",
      "command": "echo noop > /dev/null",
      "windows": {
        "command": "Restart-Service -Name 'Synergy Stream Daemon (development)'"
      }
    },
    {
      "label": "daemon-deploy",
      "type": "shell",
      "dependsOn": ["build-kill-core", "daemon-start"],
      "dependsOrder": "sequence"
    },
    {
      "label": "daemon-install",
      "type": "shell",
      "command": "echo noop > /dev/null",
      "windows": {
        "command": "New-Service -Name 'Synergy Stream Daemon (development)' -DisplayName 'Synergy Stream Daemon (development)' -BinaryPathName '${workspaceFolder}\\build\\bin-copy\\synergy-stream-daemon.exe' -StartupType Manual"
      }
    },
    {
      "label": "daemon-uninstall",
      "type": "shell",
      "command": "echo noop > /dev/null",
      "windows": {
        "command": "sc.exe delete 'Synergy Stream Daemon (development)'"
      }
    },
    {
      "label": "daemon-reinstall",
      "type": "shell",
      "dependsOn": [
        "build-kill-core",
        "daemon-stop",
        "daemon-uninstall",
        "daemon-install",
        "daemon-start"
      ],
      "dependsOrder": "sequence"
    }
  ]
}
